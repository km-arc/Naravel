<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Monorepo: every package ships with the same version (bump it here, once). -->
    <VersionPrefix>0.1.1</VersionPrefix>
    <Authors>Naravel contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/km-arc/naravel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/km-arc/naravel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Vulnerability auditing is ON for direct and transitive packages. Do not disable it per project. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <TreatWarningsAsErrors Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/src/')) Or $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\src\'))">true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <!-- Missing XML comments (CS1591) are errors for every package under /src/ (AUDIT D-17 closed) and silent elsewhere (tests, samples). -->
  <PropertyGroup Condition="!($([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/src/')) Or $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\src\')))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/src/')) Or $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\src\'))">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Trim, Native AOT and single-file analyzers on every package under src/. With TreatWarningsAsErrors a new reflection-based
         call that is not annotated fails the build (docs/en/trimming-aot.md). This is a regression gate for our own code only: it does
         not make any package IsTrimmable or IsAotCompatible, because the dependencies and a published run are not vouched for yet. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/src/')) Or $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\src\'))">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <!-- What nuget.org shows for every package under src/ (NuGet metadata cannot be edited after a version is pushed, so a change here ships with the next version).
       Release notes: a link to the GitHub release named by the tag the publish job checks (v + version), plus the changelog.
       Icon: drop a PNG (128x128 or larger, at most 1 MB) at build/icon.png and every package picks it up; without the file nothing changes.
       Tags: a project's own PackageTags replaces this fallback. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/src/')) Or $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\src\'))">
    <Copyright>Copyright (c) 2026 km-arc</Copyright>
    <PackageTags>naravel;laravel;dotnet</PackageTags>
    <NaravelReleaseTag>v$(VersionPrefix)</NaravelReleaseTag>
    <NaravelReleaseTag Condition="'$(VersionSuffix)' != ''">v$(VersionPrefix)-$(VersionSuffix)</NaravelReleaseTag>
    <PackageReleaseNotes>Release notes: https://github.com/km-arc/Naravel/releases/tag/$(NaravelReleaseTag) - full history: https://github.com/km-arc/Naravel/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageIcon Condition="Exists('$(MSBuildThisFileDirectory)build/icon.png')">icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/src/')) Or $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\src\'))">
    <None Include="$(MSBuildThisFileDirectory)build/icon.png" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)build/icon.png')" />
  </ItemGroup>
</Project>