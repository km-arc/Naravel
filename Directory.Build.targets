<Project>
  <!--
    XML documentation is enforced package by package (AUDIT D-17). A package that sets
    <NaravelRequireXmlDocs>true</NaravelRequireXmlDocs> gets CS1591 (missing XML comment on a public member) back,
    and under /src/ warnings are errors, so an undocumented public member fails the build.
  -->
  <PropertyGroup Condition="'$(NaravelRequireXmlDocs)' == 'true'">
    <NoWarn>$([System.String]::Copy('$(NoWarn)').Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>
</Project>
