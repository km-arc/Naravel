<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Naravel.Queue.Redis</RootNamespace>
    <Description>Redis queue driver for Naravel.Queue, built on StackExchange.Redis - priority buckets, delayed jobs and automatic reclaim of jobs left behind by a crashed worker.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>queue;jobs;background-jobs;laravel;naravel;redis</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naravel.Queue\Naravel.Queue.csproj" />
    <ProjectReference Include="..\Naravel.Redis\Naravel.Redis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Naravel.Queue.Redis.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>