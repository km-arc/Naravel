<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Naravel.Database.MySql</PackageId>
    <Description>MySQL driver for Naravel.Database, built on MySqlConnector.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>database;query-builder;mysql;laravel;naravel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naravel.Database\Naravel.Database.csproj" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Naravel.Database.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Naravel.Database.MySql.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
