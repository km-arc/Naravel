<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Naravel.Mail.Queue</PackageId>
    <Description>Optional Naravel.Mail adapter that delivers mail through Naravel.Queue: QueueAsync stores only the built message data.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naravel.Mail\Naravel.Mail.csproj" />
    <ProjectReference Include="..\Naravel.Queue\Naravel.Queue.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Naravel.Mail.Queue.Tests" />
  </ItemGroup>
</Project>
