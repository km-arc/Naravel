<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Naravel.Broadcasting</PackageId>
    <Description>Typed real-time broadcasting over SignalR for Naravel: IBroadcastable events, channel authorization rules, signalr/log/null drivers and a test fake, built on Naravel.Foundation and Naravel.Events.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NaravelRequireXmlDocs>true</NaravelRequireXmlDocs>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naravel.Foundation\Naravel.Foundation.csproj" />
    <ProjectReference Include="..\Naravel.Cache\Naravel.Cache.csproj" />
    <ProjectReference Include="..\Naravel.Events\Naravel.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Naravel.Broadcasting.Tests" />
  </ItemGroup>
</Project>
