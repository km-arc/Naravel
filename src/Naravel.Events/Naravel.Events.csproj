<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Naravel.Events</PackageId>
    <Description>Typed event dispatcher with listener ordering, stop propagation, and optional queue adapter support.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Naravel.Events.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Naravel.Events.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
