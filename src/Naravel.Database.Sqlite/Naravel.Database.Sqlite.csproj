<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Naravel.Database.Sqlite</PackageId>
    <Description>SQLite driver for Naravel.Database, built on Microsoft.Data.Sqlite.</Description>
    <PackageTags>database;query-builder;sqlite;laravel;naravel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NaravelRequireXmlDocs>true</NaravelRequireXmlDocs>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naravel.Database\Naravel.Database.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Microsoft.Data.Sqlite brings lib.e_sqlite3 2.1.11 (CVE-2025-6965); the central version pins the patched 2.1.14. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Naravel.Database.Tests" />
  </ItemGroup>
</Project>
