<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Naravel.Queue.Encryption</PackageId>
    <Description>Optional Naravel.Queue adapter that encrypts the payload of jobs marked IShouldBeEncrypted with ASP.NET Core Data Protection. Unmarked jobs keep the existing wire format.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>queue;jobs;encryption;data-protection;laravel;naravel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naravel.Encryption\Naravel.Encryption.csproj" />
    <ProjectReference Include="..\Naravel.Queue\Naravel.Queue.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Naravel.Queue.Encryption.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Naravel.Queue.Encryption.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
