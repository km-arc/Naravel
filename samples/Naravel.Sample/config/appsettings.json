{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },

  "NaravelQueue": {
    "Default": "file",
    "SampleConnection": "file",

    "Stores": {
      "sync": {
        "Driver": "memory",
        "Queue": "default"
      },

      "file": {
        "Driver": "file",
        "Queue": "default",
        "Path": "storage/netqueue"
      },

      "redis": {
        "Driver": "redis",
        "Queue": "default",
        "ConnectionString": "localhost:6379",
        "VisibilityTimeoutSeconds": "300"
      },

      "database": {
        "Driver": "database",
        "Queue": "default"
      },

      "rabbitmq": {
        "Driver": "rabbitmq",
        "Queue": "default",
        "HostName": "localhost",
        "Port": "5672",
        "UserName": "guest",
        "Password": "guest",
        "VirtualHost": "/"
      },

      "kafka": {
        "Driver": "kafka",
        "Queue": "default",
        "BootstrapServers": "localhost:9092",
        "GroupId": "netqueue-workers"
      }
    }
  }
}
