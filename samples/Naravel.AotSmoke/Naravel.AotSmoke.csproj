<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native AOT smoke sample (docs/en/trimming-aot.md). It is published with ILC and run by the evidence workflow, report-only;
       it is not part of Naravel.slnx and never shipped. Every call below uses the trim/AOT-safe path of its package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Naravel.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One line per warning instead of one per assembly, so the report names the dependency that is not trim-safe. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Naravel.Cache\Naravel.Cache.csproj" />
    <ProjectReference Include="..\..\src\Naravel.Events\Naravel.Events.csproj" />
    <ProjectReference Include="..\..\src\Naravel.Mail\Naravel.Mail.csproj" />
    <ProjectReference Include="..\..\src\Naravel.Queue\Naravel.Queue.csproj" />
    <ProjectReference Include="..\..\src\Naravel.Queue.Memory\Naravel.Queue.Memory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
