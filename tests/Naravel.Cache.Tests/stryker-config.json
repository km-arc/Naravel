{
  "stryker-config": {
    "project": "Naravel.Cache.csproj",
    "mutate": [
      "**/CacheLockLease.cs",
      "**/CacheLockLeaseOptions.cs",
      "**/CacheLockExtensions.cs{160..237}"
    ],
    "test-case-filter": "FullyQualifiedName~CacheLockLeaseTests",
    "mutation-level": "Standard",
    "ignore-methods": [
      "ConfigureAwait"
    ],
    "reporters": [
      "cleartext",
      "html",
      "json"
    ],
    "concurrency": 2,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
